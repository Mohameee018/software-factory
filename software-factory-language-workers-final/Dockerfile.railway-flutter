FROM ghcr.io/cirruslabs/flutter:stable

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/factory-venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/factory-venv

WORKDIR /app
COPY . /app

RUN /opt/factory-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/factory-venv/bin/pip install --no-cache-dir .

RUN mkdir -p /data/projects /data/logs

ENV DATABASE_PATH=/data/factory.db \
    WORKSPACE_PATH=/data/projects

CMD ["factory", "telegram"]
