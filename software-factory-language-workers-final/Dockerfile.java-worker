FROM gradle:8.14.5-jdk21-noble
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 WORKER_TYPE=java
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip maven git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN pip3 install --break-system-packages --no-cache-dir .
RUN mkdir -p /data/projects /data/logs
ENV DATABASE_PATH=/data/factory.db WORKSPACE_PATH=/data/projects
CMD ["factory","worker"]
